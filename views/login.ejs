<%- include('partials/auth-layout-top', { title: 'Log in' }) %>
  <%- include('partials/auth-aside') %>
  <main class="flex items-center justify-center bg-surface px-6 py-12">
    <div class="w-full max-w-sm">
      <h1>Log in</h1>
      <p class="mt-1 text-ink-soft">Use your OpsPilot account.</p>

      <% if (error) { %><p class="notice-error mt-6" role="alert"><%= error %></p><% } %>

      <form action="/login" method="POST" class="mt-6 space-y-4" id="loginForm">
        <label class="field">Email
          <input class="input" type="email" name="email" required autofocus autocomplete="username" value="<%= email %>" />
        </label>
        <label class="field">Password
          <input class="input" type="password" name="password" required autocomplete="current-password" />
        </label>
        <button type="submit" class="btn-primary w-full py-2.5">Log in</button>
      </form>
      <p class="mt-4 text-sm text-ink-soft">No account? <a href="/register">Create one</a></p>

      <div class="mt-10 border-t border-line pt-6">
        <h2 class="text-sm font-medium text-ink">Demo accounts</h2>
        <p class="hint mt-0.5">Password <code>password123</code>. Pick one to fill in the form.</p>
        <div class="mt-3 grid grid-cols-2 gap-2">
          <% [['enduser@opspilot.test', 'Erin Carter', 'End user'], ['agent@opspilot.test', 'Adel Haddad', 'Agent'],
              ['agent2@opspilot.test', 'Sara Ali', 'Agent'], ['manager@opspilot.test', 'Mona Saleh', 'Manager']].forEach(function(d) { %>
            <button type="button" class="btn-secondary h-auto flex-col items-start gap-0 py-2 text-left" data-demo="<%= d[0] %>">
              <span class="text-sm font-medium"><%= d[1] %></span>
              <span class="text-xs font-normal text-muted"><%= d[2] %></span>
            </button>
          <% }) %>
        </div>
      </div>
    </div>
  </main>
  </div>
  <script>
    document.querySelectorAll('[data-demo]').forEach(function (b) {
      b.addEventListener('click', function () {
        var f = document.getElementById('loginForm');
        f.email.value = b.dataset.demo;
        f.password.value = 'password123';
        f.querySelector('button[type=submit]').focus();
      });
    });
  </script>
</body>
</html>
