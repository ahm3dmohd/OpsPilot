<%- include('partials/layout-top', { title: 'My tickets' }) %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1>My tickets</h1>
    <p class="mt-1 text-sm text-muted">Everything you've reported, newest first.</p>
  </div>
  <a href="/tickets/new" class="btn-primary"><%- icon('plus') %> New ticket</a>
</div>

<% if (tickets.length === 0) { %>
  <div class="panel mt-6 panel-body">
    <h2>No tickets yet</h2>
    <p class="mt-1 text-sm text-ink-soft">Report something that's broken, or request something new, and follow its progress here. Many common problems have a quick fix in the <a href="/kb">knowledge base</a>.</p>
    <a href="/tickets/new" class="btn-primary mt-4"><%- icon('plus') %> New ticket</a>
  </div>
<% } else { %>
  <section class="panel mt-6 overflow-hidden">
    <% tickets.forEach(function(t) { %>
      <% var open = t.status === 'Open' || t.status === 'In Progress' || t.status === 'Pending Approval'; %>
      <a href="/tickets/<%= t.ticketId %>" class="strip strip-<%= slug(t.priority) %> <%= open ? '' : 'strip-closed' %> sm:grid-cols-[5.5rem_1fr_auto]">
        <span class="callsign"><%= t.ticketId %></span>
        <span class="min-w-0">
          <span class="block truncate font-medium text-ink"><%= t.title %></span>
          <span class="mt-0.5 flex flex-wrap gap-x-3 text-[13px] text-muted">
            <span><%= t.category %></span>
            <span><%= t.status === 'Pending Approval' ? 'Waiting for approval' : t.status === 'Rejected' ? 'Not approved' : t.assigneeName ? t.assigneeName + ' is on it' : 'Waiting for an agent' %></span>
            <span title="<%= fullDate(t.updatedAt) %>">updated <%= timeAgo(t.updatedAt) %></span>
          </span>
        </span>
        <span class="col-start-2 flex flex-wrap gap-1.5 sm:col-start-auto">
          <%- include('partials/type-pill', { type: t.type }) %>
          <span class="pill-<%= slug(t.priority) %>"><%= t.priority %></span>
          <span class="pill-<%= slug(t.status) %> pill-status-<%= slug(t.status) %>"><%= t.status %></span>
        </span>
      </a>
    <% }) %>
  </section>
<% } %>

<%- include('partials/help-widget') %>
<%- include('partials/layout-bottom') %>
