# Copy this file to .env and fill in real values. Never commit .env itself.
# Every value is optional: with nothing set, the app runs in mock-data mode
# (in-memory users and tickets, no database) with keyword-only matching.
# Demo login credentials are in README.md.

PORT=3000

# MongoDB connection string. Leave blank for mock-data mode. If it's set
# but the database can't be reached within 5s, the app also falls back to
# mock-data mode (and says so in the console).
# Local:  mongodb://localhost:27017/OpsPilot
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/OpsPilot
# Plain MongoDB is enough - similarity is computed in application code, no
# Atlas Vector Search needed. Run `npm run seed` once after setting it.
MONGODB_URI=

# Embeddings API key for the AI features (duplicate detection,
# auto-categorization, help assistant). Either:
#   - a Google Gemini key (from aistudio.google.com) -> gemini-embedding-001
#   - an OpenAI key ("sk-...")                       -> text-embedding-3-small
# The provider is picked from the key's format; set EMBEDDINGS_PROVIDER to
# "gemini" or "openai" to force one. Without a key the AI method shows as
# "skipped" and the keyword baseline still works - nothing breaks.
LLM_API_KEY=
EMBEDDINGS_PROVIDER=

# Similarity thresholds (optional - defaults come from `npm run evaluate`):
# AI default 0.88 for Gemini, 0.82 for OpenAI (OpenAI's is uncalibrated).
# Baseline (keyword Jaccard) default 0.10.
AI_SIMILARITY_THRESHOLD=
BASELINE_SIMILARITY_THRESHOLD=

# Session cookie secret - TREAT IT LIKE A PASSWORD. Anyone who knows it can
# forge a login cookie for any user, including a manager. Use a long
# random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit it, never paste it into chats or screenshots, and change it
# if it leaks (that logs everyone out). Required when NODE_ENV=production.
SESSION_SECRET=

# Demo only: lets the sign-up page create agent/manager accounts. Leave
# unset (or false) for anything real - otherwise anyone can make
# themselves a manager.
ALLOW_ROLE_SELECT_ON_REGISTER=
