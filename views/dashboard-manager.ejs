<%- include('partials/layout-top', { title: 'Overview' }) %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1>Overview</h1>
    <p class="mt-1 text-sm text-muted">Every number opens the tickets behind it. Data source: <%= mode === 'db' ? 'MongoDB' : 'demo data (in memory)' %>.</p>
  </div>
  <a href="/reports/tickets.csv" class="btn-secondary"><%- icon('download') %> Export CSV</a>
</div>

<%# ---- What needs attention now: the SLA watch list ---- %>
<section class="panel mt-6 overflow-hidden" aria-labelledby="slaWatch">
  <div class="panel-head">
    <h2 id="slaWatch" class="flex items-center gap-2"><%- icon('clock', 'size-[18px] text-muted') %> SLA watch</h2>
    <span class="text-xs text-muted">Open and In Progress tickets</span>
  </div>
  <div class="grid grid-cols-3 divide-x divide-line border-b border-line">
    <% var slaText = { breached: 'Breached', at_risk: 'At risk', ok: 'On track' };
       var slaColor = { breached: 'text-danger', at_risk: 'text-caution', ok: 'text-ink' }; %>
    <% slaCards.forEach(function(c) { %>
      <a class="gauge sla-card-<%= c.key %>" href="<%= c.href %>">
        <span class="gauge-value <%= slaColor[c.key] %>"><%= c.count %></span>
        <span class="gauge-label"><%= slaText[c.key] %><%= c.key === 'at_risk' ? ' (75%+ of time used)' : '' %></span>
      </a>
    <% }) %>
  </div>
  <% if (atRisk.length) { %>
    <div>
      <% atRisk.forEach(function(t) { %><%- include('partials/ticket-strip', { t: t }) %><% }) %>
    </div>
  <% } else { %>
    <p class="flex items-center gap-2 px-5 py-6 text-sm text-ok"><%- icon('circle-check') %> Nothing is close to missing its response or resolution time.</p>
  <% } %>
</section>

<%# ---- Ticket counts: one instrument panel ---- %>
<section class="panel mt-6" aria-label="Ticket counts">
  <div class="grid grid-cols-2 divide-line sm:grid-cols-3 sm:divide-x lg:grid-cols-6">
    <a class="gauge" href="<%= total.href %>"><span class="gauge-value"><%= total.count %></span><span class="gauge-label">All tickets</span></a>
    <% byStatus.forEach(function(x) { %>
      <a class="gauge" href="<%= x.href %>"><span class="gauge-value"><%= x.count %></span><span class="gauge-label"><%= x.label %></span></a>
    <% }) %>
    <a class="gauge" href="<%= unassigned.href %>"><span class="gauge-value <%= unassigned.count ? 'text-caution' : '' %>"><%= unassigned.count %></span><span class="gauge-label">Active, unassigned</span></a>
  </div>
</section>

<%# ---- Breakdowns with proportional bars ---- %>
<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <% [['By category', byCategory, ''], ['By priority', byPriority, ''], ['Agent workload', workloads, ' in progress']].forEach(function(group) {
       var rows = group[1]; var max = Math.max.apply(null, rows.map(function(r) { return r.count; }).concat([1])); %>
    <section class="panel">
      <div class="panel-head"><h2><%= group[0] %></h2></div>
      <% if (rows.length === 0) { %>
        <p class="panel-body text-sm text-muted">No agents yet.</p>
      <% } else { %>
        <ul class="py-2">
          <% rows.forEach(function(x) { %>
            <li>
              <a href="<%= x.href %>" class="group flex flex-col gap-1.5 px-5 py-2 text-ink no-underline hover:bg-sunken hover:no-underline">
                <span class="flex items-baseline justify-between gap-3 text-sm">
                  <span class="group-hover:text-brand"><%= x.label %></span>
                  <span class="font-semibold tabular-nums"><%= x.count %><span class="font-normal text-muted"><%= group[2] %></span></span>
                </span>
                <span class="h-1.5 overflow-hidden rounded-full bg-sunken"><span class="block h-full rounded-full bg-brand/70" style="width: <%= Math.round(x.count / max * 100) %>%"></span></span>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% }) %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <%# ---- AI features ---- %>
  <section class="panel">
    <div class="panel-head">
      <h2 class="flex items-center gap-2"><%- icon('sparkles', 'size-[18px] text-muted') %> Duplicate detection</h2>
      <a href="/evaluation" class="text-sm">Measured accuracy</a>
    </div>
    <ul class="py-2">
      <% dupStats.forEach(function(x) { %>
        <li><a href="<%= x.href %>" class="flex justify-between gap-3 px-5 py-1.5 text-sm text-ink no-underline hover:bg-sunken hover:no-underline"><span><%= x.label %></span><span class="font-semibold tabular-nums"><%= x.count %></span></a></li>
      <% }) %>
      <li class="flex justify-between gap-3 border-t border-line px-5 pt-3 pb-1.5 mt-2 text-sm">
        <span>Category suggestions kept as-is</span>
        <span class="font-semibold tabular-nums"><a href="<%= suggestionStats.accepted.href %>"><%= suggestionStats.accepted.count %></a> <span class="font-normal text-muted">of</span> <a href="<%= suggestionStats.total.href %>"><%= suggestionStats.total.count %></a></span>
      </li>
    </ul>
  </section>

  <%# ---- Knowledge base ---- %>
  <section class="panel overflow-hidden">
    <div class="panel-head">
      <h2 class="flex items-center gap-2"><%- icon('book-open', 'size-[18px] text-muted') %> Knowledge base</h2>
      <a href="/kb" class="text-sm">Manage articles</a>
    </div>
    <% if (kbStats.length === 0) { %>
      <p class="panel-body text-sm text-muted">No articles yet.</p>
    <% } else { %>
      <table class="data-table">
        <thead><tr><th>Most viewed</th><th class="text-right">Views</th><th class="text-right">Helpful</th><th class="text-right">Not helpful</th></tr></thead>
        <tbody>
          <% kbStats.forEach(function(a) { %>
            <tr>
              <td><a href="/kb/<%= a.articleId %>" class="callsign mr-1.5"><%= a.articleId %></a> <%= a.title %></td>
              <td class="text-right tabular-nums"><a href="/kb/<%= a.articleId %>"><%= a.views %></a></td><td class="text-right tabular-nums"><a href="/kb/<%= a.articleId %>"><%= a.helpful %></a></td><td class="text-right tabular-nums"><a href="/kb/<%= a.articleId %>"><%= a.notHelpful %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%# ---- Latest tickets ---- %>
<section class="panel mt-6 overflow-hidden">
  <div class="panel-head">
    <h2>Latest tickets</h2>
    <a href="/tickets" class="text-sm">All <%= tickets.length %> tickets, with filters</a>
  </div>
  <div>
    <% tickets.slice(0, 8).forEach(function(t) { %><%- include('partials/ticket-strip', { t: t }) %><% }) %>
  </div>
</section>

<%- include('partials/layout-bottom') %>
