<%- include('partials/layout-top', { title: 'Canned responses' }) %>
<% var flashes = { created: 'Canned response added.', saved: 'Changes saved.', deleted: 'Canned response deleted.' }; %>

<h1>Canned responses</h1>
<p class="mt-1 max-w-3xl text-sm text-muted">Saved replies for common answers. On a ticket, pick one above the comment box to insert its text, then edit it before posting.</p>
<% if (flash && flashes[flash]) { %><p class="notice-ok mt-4" role="status"><%= flashes[flash] %></p><% } %>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_22rem]">
  <section aria-label="Saved replies">
    <% if (responses.length === 0) { %>
      <p class="text-sm text-muted">No canned responses yet. Add the first one with the form.</p>
    <% } else { %>
      <ul class="panel divide-y divide-line">
        <% responses.forEach(function(r) { %>
          <li class="px-5 py-4" data-canned-row>
            <div class="flex flex-wrap items-start justify-between gap-3">
              <h2 class="text-base"><%= r.title %></h2>
              <div class="flex gap-2">
                <a href="/canned/<%= r.id %>/edit" class="btn-secondary btn-sm"><%- icon('pencil', 'size-3.5') %> Edit</a>
                <% if (can('canned.delete')) { %>
                  <form action="/canned/<%= r.id %>/delete" method="POST" data-confirm="Delete this canned response?">
                    <button type="submit" class="btn-danger btn-sm"><%- icon('trash-2', 'size-3.5') %> Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
            <p class="prose-text mt-1 text-ink-soft"><%= r.body %></p>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section aria-labelledby="newCanned">
    <form action="/canned" method="POST" class="panel panel-body space-y-4">
      <h2 id="newCanned" class="text-base">New canned response</h2>
      <% if (error) { %><p class="notice-error" role="alert"><%= error %></p><% } %>
      <label class="field">Title
        <input class="input" type="text" name="title" required maxlength="100" value="<%= form.title || '' %>" placeholder="Shown in the dropdown" />
      </label>
      <label class="field">Text
        <textarea class="input" name="body" rows="6" required maxlength="5000"><%= form.body || '' %></textarea>
      </label>
      <div class="flex justify-end">
        <button type="submit" class="btn-primary"><%- icon('plus') %> Add</button>
      </div>
    </form>
  </section>
</div>

<%- include('partials/layout-bottom') %>
