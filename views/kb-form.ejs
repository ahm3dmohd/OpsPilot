<%- include('partials/layout-top', { title: article ? 'Edit ' + article.articleId : 'New article' }) %>

<a href="<%= article ? '/kb/' + article.articleId : '/kb' %>" class="inline-flex items-center gap-1.5 text-sm text-ink-soft no-underline hover:text-ink"><%- icon('arrow-left') %> Back</a>

<div class="mt-4 max-w-2xl">
  <h1><%= article ? 'Edit ' + article.articleId : 'New article' %></h1>
  <% if (error) { %><p class="notice-error mt-6" role="alert"><%= error %></p><% } %>
  <form action="<%= article ? '/kb/' + article.articleId : '/kb' %>" method="POST" class="panel panel-body mt-6 space-y-5">
    <label class="field">Title
      <input class="input" type="text" name="title" required maxlength="150" value="<%= form.title || '' %>" placeholder="Name the problem the way a user would" />
    </label>
    <label class="field">Category
      <select class="input" name="category">
        <% CATEGORIES.forEach(function(c) { %><option <%= form.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </select>
    </label>
    <label class="field">Body
      <textarea class="input" name="body" rows="10" required maxlength="10000"><%= form.body || '' %></textarea>
      <span class="hint">Plain text. The help assistant searches the title and body, so describe the symptom in the words a user would use.</span>
    </label>
    <div class="flex justify-end border-t border-line pt-5">
      <button type="submit" class="btn-primary"><%= article ? 'Save changes' : 'Publish article' %></button>
    </div>
  </form>
</div>

<%- include('partials/layout-bottom') %>
