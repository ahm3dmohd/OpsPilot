<%- include('partials/layout-top', { title: 'My approvals' }) %>
<% var flashes = { approved: 'Approved. It has moved on to the next step, or to the queue if that was the last one.', request_rejected: 'Rejected. The requester has been told why.' };
   var errors = { reason_required: 'Give a reason when you reject a request. The requester sees it.', not_pending: 'That step has already been decided or moved on.' }; %>

<h1>My approvals</h1>
<p class="mt-1 max-w-3xl text-sm text-muted">Service requests waiting for your decision, as someone's line manager or a department head. Approving sends a request on to the next approver, or to the department's queue after the last one. Rejecting ends it and the requester sees your reason.</p>
<% if (flash && flashes[flash]) { %><p class="notice-ok mt-4" role="status"><%= flashes[flash] %></p><% } %>
<% if (flash && errors[flash]) { %><p class="notice-error mt-4" role="alert"><%= errors[flash] %></p><% } %>

<section class="mt-6" aria-labelledby="waiting">
  <h2 id="waiting">Waiting for you <span class="text-base font-normal text-muted">(<%= pending.length %>)</span></h2>
  <% if (pending.length === 0) { %>
    <div class="panel panel-body mt-3">
      <p class="font-medium">Nothing to approve right now.</p>
      <p class="mt-1 text-sm text-muted">When someone who reports to you, or someone in a department you head, makes a service request, it appears here and in your notifications.</p>
    </div>
  <% } else { %>
    <div class="mt-3 space-y-4">
      <% pending.forEach(function(s) { var t = s.ticket; %>
        <article class="panel overflow-hidden" data-pending-step="<%= s.id %>" data-ticket-id="<%= t.ticketId %>">
          <div class="px-5 py-4">
            <div class="flex flex-wrap items-center gap-2">
              <a href="/tickets/<%= t.ticketId %>" class="callsign text-brand-ink"><%= t.ticketId %></a>
              <%- include('partials/type-pill', { type: t.type }) %>
              <span class="dept-tag" title="Target department"><%= t.department || 'IT' %></span>
              <span class="text-xs text-muted">Step <%= s.order %>: <%= s.label %></span>
            </div>
            <h3 class="mt-1 text-base"><a href="/tickets/<%= t.ticketId %>" class="text-ink"><%= t.title %></a></h3>
            <p class="mt-0.5 text-sm text-muted">From <%= t.requesterName %>, <span title="<%= fullDate(t.createdAt) %>"><%= timeAgo(t.createdAt) %></span><% if (t.neededBy) { %>, needed by <%= fullDate(t.neededBy).split(',')[0] %><% } %></p>
            <p class="prose-text mt-2 text-sm"><%= t.description %></p>
            <% if (t.justification) { %><p class="prose-text mt-2 text-sm text-ink-soft"><span class="font-medium text-ink">Why: </span><%= t.justification %></p><% } %>
          </div>
          <%- include('partials/approval-actions', { step: s, returnTo: 'list' }) %>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<% if (decided.length) { %>
  <section class="mt-8" aria-labelledby="decidedHeading">
    <h2 id="decidedHeading">Recently decided</h2>
    <section class="panel mt-3 overflow-x-auto">
      <table class="data-table">
        <thead><tr><th>Ticket</th><th>Step</th><th>Decision</th><th>Comment</th><th>When</th></tr></thead>
        <tbody>
          <% decided.forEach(function(s) { %>
            <tr>
              <td><a href="/tickets/<%= s.ticketId %>" class="callsign text-brand-ink"><%= s.ticketId %></a> <%= s.ticket.title %></td>
              <td><%= s.label %></td>
              <td><span class="pill-step-<%= s.status %>"><%= s.status === 'approved' ? 'Approved' : 'Rejected' %></span></td>
              <td class="max-w-xs"><%= s.comment || '' %></td>
              <td class="whitespace-nowrap" title="<%= fullDate(s.decidedAt) %>"><%= timeAgo(s.decidedAt) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </section>
<% } %>

<%- include('partials/layout-bottom') %>
