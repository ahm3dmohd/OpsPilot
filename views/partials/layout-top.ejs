<%# App shell: sidebar + top bar. Each page includes this, then its content,
    then partials/layout-bottom. Expects: title. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('head', { title: title }) %>
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 btn-primary">Skip to content</a>
  <div class="lg:grid lg:grid-cols-[15rem_1fr] min-h-screen">

    <%# ---- Sidebar ---- %>
    <aside id="sidebar" data-open="false"
      class="fixed inset-y-0 left-0 z-40 flex w-60 -translate-x-full flex-col border-r border-line bg-surface transition-transform data-[open=true]:translate-x-0 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">
      <a href="/dashboard" class="flex items-center gap-2.5 px-5 py-5 no-underline hover:no-underline">
        <span class="flex size-8 items-center justify-center rounded-md bg-brand text-on-brand"><%- icon('ticket', 'size-[18px]') %></span>
        <span class="text-[17px] font-semibold tracking-tight text-ink">OpsPilot</span>
      </a>

      <% var path = currentPath || ''; var on = function(p) { return path === p || path.indexOf(p + '/') === 0 ? 'aria-current="page"' : ''; }; %>
      <nav class="flex flex-1 flex-col gap-0.5 px-3" aria-label="Main">
        <a href="/dashboard" class="nav-link" <%- on('/dashboard') %>><%- icon('layout-dashboard') %> Dashboard</a>
        <% if (can('ticket.view_all')) { %>
          <a href="/tickets" class="nav-link" <%- path === '/tickets' ? 'aria-current="page"' : '' %>><%- icon('inbox') %> Tickets</a>
        <% } %>
        <% if (can('ticket.create')) { %>
          <a href="/tickets/new" class="nav-link" <%- on('/tickets/new') %>><%- icon('plus') %> New ticket</a>
          <a href="/help" class="nav-link" <%- on('/help') %>><%- icon('life-buoy') %> Get help</a>
        <% } %>
        <a href="/approvals" class="nav-link" <%- on('/approvals') %>>
          <%- icon('stamp') %> My approvals
          <% if (approvalCount) { %><span class="ml-auto rounded-full bg-caution px-1.5 text-xs font-semibold text-white approval-count" data-badge="approvals" data-value="<%= approvalCount %>" aria-label="<%= approvalCount %> waiting"><%= approvalCount %></span><% } %>
        </a>
        <a href="/kb" class="nav-link" <%- on('/kb') %>><%- icon('book-open') %> Knowledge base</a>
        <% if (can('canned.use')) { %>
          <a href="/canned" class="nav-link" <%- on('/canned') %>><%- icon('message-square-text') %> Canned responses</a>
        <% } %>
        <a href="/notifications" class="nav-link" <%- on('/notifications') %>>
          <%- icon('bell') %> Notifications
          <% if (unreadCount) { %><span class="ml-auto rounded-full bg-danger px-1.5 text-xs font-semibold text-white notif-count" data-badge="notifications" data-value="<%= unreadCount %>"><%= unreadCount %></span><% } %>
        </a>
        <% if (can('report.view') || can('audit.view') || can('report.export')) { %>
          <p class="mt-5 mb-1 px-3 text-xs font-medium text-muted">Reports</p>
          <% if (can('report.view')) { %>
            <a href="/evaluation" class="nav-link" <%- on('/evaluation') %>><%- icon('flask-conical') %> AI evaluation</a>
            <a href="/admin/duplicate-stats" class="nav-link" <%- on('/admin/duplicate-stats') %>><%- icon('git-compare') %> Duplicate decisions</a>
          <% } %>
          <% if (can('audit.view')) { %><a href="/audit" class="nav-link" <%- on('/audit') %>><%- icon('shield-check') %> Audit log</a><% } %>
          <% if (can('report.export')) { %><a href="/reports/tickets.csv" class="nav-link"><%- icon('download') %> Export CSV</a><% } %>
        <% } %>
        <% if (can('user.manage') || can('department.manage') || can('approval.reassign') || can('settings.edit')) { %>
          <p class="mt-5 mb-1 px-3 text-xs font-medium text-muted">Administration</p>
          <% if (can('user.manage')) { %>
            <a href="/admin/users" class="nav-link" <%- on('/admin/users') %>><%- icon('users') %> Users &amp; roles</a>
            <a href="/admin/permissions" class="nav-link" <%- on('/admin/permissions') %>><%- icon('key-round') %> Permissions</a>
          <% } %>
          <% if (can('department.manage')) { %><a href="/admin/departments" class="nav-link" <%- on('/admin/departments') %>><%- icon('building-2') %> Departments</a><% } %>
          <% if (can('approval.reassign')) { %><a href="/admin/approvals" class="nav-link" <%- on('/admin/approvals') %>><%- icon('route') %> Open approvals</a><% } %>
          <% if (can('settings.edit')) { %><a href="/admin/settings" class="nav-link" <%- on('/admin/settings') %>><%- icon('sliders-horizontal') %> Settings</a><% } %>
        <% } %>
      </nav>

      <div class="border-t border-line p-3">
        <div class="flex items-center gap-3 px-2 py-2">
          <span class="avatar"><%= initials(currentUser.name) %></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-ink"><%= currentUser.name %></p>
            <p class="text-xs text-muted"><%= roleLabel(currentUser.role) %></p>
          </div>
        </div>
        <form action="/logout" method="POST">
          <button type="submit" class="nav-link w-full cursor-pointer"><%- icon('log-out') %> Log out</button>
        </form>
      </div>
    </aside>
    <div id="sidebarScrim" class="fixed inset-0 z-30 hidden bg-ink/40 lg:hidden"></div>

    <%# ---- Main column ---- %>
    <div class="flex min-w-0 flex-col">
      <header class="sticky top-0 z-20 flex items-center gap-3 border-b border-line bg-canvas/90 px-4 py-3 backdrop-blur sm:px-8">
        <button type="button" id="menuButton" class="btn-ghost -ml-2 px-2 lg:hidden" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false"><%- icon('menu', 'size-5') %></button>
        <% if (can('ticket.view_all')) { %>
          <form action="/tickets" method="GET" role="search" class="relative flex-1 max-w-md">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-muted"><%- icon('search') %></span>
            <input id="globalSearch" type="search" name="q" placeholder="Search tickets" aria-label="Search tickets" class="input py-1.5 pl-9 pr-9" />
            <kbd class="pointer-events-none absolute inset-y-0 right-2 my-auto hidden h-5 rounded border border-line px-1.5 font-mono text-[11px] leading-5 text-muted sm:block">/</kbd>
          </form>
        <% } else { %>
          <form action="/kb" method="GET" role="search" class="relative flex-1 max-w-md">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-muted"><%- icon('search') %></span>
            <input id="globalSearch" type="search" name="q" placeholder="Search help articles" aria-label="Search help articles" class="input py-1.5 pl-9 pr-9" />
            <kbd class="pointer-events-none absolute inset-y-0 right-2 my-auto hidden h-5 rounded border border-line px-1.5 font-mono text-[11px] leading-5 text-muted sm:block">/</kbd>
          </form>
        <% } %>
        <div class="ml-auto flex items-center gap-1">
          <%# Palette PREVIEW picker - remove once a palette is chosen. %>
          <label class="sr-only" for="paletteSelect">Colour palette (preview)</label>
          <select id="paletteSelect" class="input w-auto py-1 pr-7 text-[13px]" title="Colour palette (preview)">
            <option value="approach">Approach</option>
            <option value="signage">Signage</option>
            <option value="dusk">Dusk</option>
            <option value="harbour">Harbour (current)</option>
          </select>
          <button type="button" id="themeToggle" class="btn-ghost px-2" aria-label="Switch to dark mode">
            <span class="dark:hidden"><%- icon('moon') %></span><span class="hidden dark:inline"><%- icon('sun') %></span>
          </button>
          <a href="/notifications" class="btn-ghost relative px-2" aria-label="Notifications<%= unreadCount ? ', ' + unreadCount + ' unread' : '' %>">
            <%- icon('bell') %>
            <% if (unreadCount) { %><span class="absolute top-1 right-1 size-2 rounded-full bg-danger"></span><% } %>
          </a>
        </div>
      </header>

      <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-8">
