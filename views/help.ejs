<%- include('partials/layout-top', { title: 'Get help' }) %>

<div class="max-w-2xl">
  <h1>Get help</h1>
  <p class="mt-1 text-ink-soft">Describe the problem. We'll check the knowledge base and your open tickets before you report anything new.</p>
  <form action="/help" method="GET" class="mt-6 flex gap-2">
    <input class="input" type="text" name="q" value="<%= q %>" maxlength="500" required placeholder="e.g. my VPN keeps disconnecting" />
    <button type="submit" class="btn-primary"><%- icon('search') %> Search</button>
  </form>

  <% if (result) { %>
    <% if (result.ownTickets.length) { %>
      <section class="panel mt-6 panel-body">
        <h2 class="text-base">You already have a related ticket</h2>
        <% result.ownTickets.forEach(function(t) { %>
          <p class="mt-2 text-sm"><a href="/tickets/<%= t.ticketId %>"><span class="callsign text-brand-ink"><%= t.ticketId %></span> <%= t.title %></a> <span class="text-muted">(<%= t.status %>)</span></p>
        <% }) %>
      </section>
    <% } %>
    <h2 class="mt-8">Help articles</h2>
    <% if (result.articles.length === 0) { %>
      <p class="mt-2 text-sm text-muted">No article matches that question.</p>
    <% } %>
    <div class="mt-3 space-y-3">
      <% result.articles.forEach(function(a) { %>
        <article class="panel panel-body">
          <h3><a href="/kb/<%= a.articleId %>"><%= a.title %></a></h3>
          <p class="mt-1 text-sm text-ink-soft"><%= a.body %></p>
        </article>
      <% }) %>
    </div>
    <div class="mt-6 flex items-center gap-4">
      <% if (can('ticket.create')) { %><a href="/tickets/new" class="btn-primary"><%- icon('plus') %> Report a problem</a><% } %>
      <span class="text-xs text-muted">Matched by <%= result.method === 'ai' ? 'AI (embeddings)' : 'keywords' %>.</span>
    </div>
  <% } %>
</div>

<%- include('partials/layout-bottom') %>
