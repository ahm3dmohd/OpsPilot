{
  "name": "opspilot",
  "version": "0.2.0",
  "description": "OpsPilot - a HelpDesk/ITSM ticketing system with AI-assisted duplicate detection (Bahrain Polytechnic CLP capstone)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "make-admin": "node scripts/make-admin.js",
    "evaluate": "node scripts/evaluate.js",
    "test": "node scripts/smoke-test.js",
    "build:css": "node scripts/copy-fonts.js && tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "lucide-static": "^1.52.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.4",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
