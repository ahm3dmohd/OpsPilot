<%# expects: t (ticket). Shows both methods' counts separately. %>
<% if (t.duplicates) { %>
  <% const ai = t.duplicates.ai, kw = t.duplicates.baseline; %>
  <% if (ai.matches.length || kw.matches.length) { %>
    <span class="dup-badge" title="Possible duplicates - AI: <%= ai.status === 'ok' ? ai.matches.length : ai.status %>, keyword: <%= kw.matches.length %>">
      Dup? AI <%= ai.status === 'ok' ? ai.matches.length : '–' %> &middot; KW <%= kw.matches.length %>
    </span>
  <% } %>
<% } %>
