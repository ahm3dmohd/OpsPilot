<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Manager overview' }) %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <div class="page-header">
      <h1>Overview</h1>
      <span class="muted small">Data: <%= mode === 'db' ? 'MongoDB' : 'mock (in-memory)' %></span>
    </div>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-number"><%= total %></div>
        <div class="stat-label">Total tickets</div>
      </div>
      <% Object.keys(byStatus).forEach(function(s) { %>
        <div class="stat-card">
          <div class="stat-number"><%= byStatus[s] %></div>
          <div class="stat-label"><%= s %></div>
        </div>
      <% }) %>
      <div class="stat-card">
        <div class="stat-number"><%= unassigned %></div>
        <div class="stat-label">Active, unassigned</div>
      </div>
    </div>

    <h2>SLA watch</h2>
    <div class="stat-grid">
      <div class="stat-card sla-card-breached"><div class="stat-number"><%= slaCounts.breached %></div><div class="stat-label">Breached</div></div>
      <div class="stat-card sla-card-at_risk"><div class="stat-number"><%= slaCounts.at_risk %></div><div class="stat-label">At risk (&ge;75% of target used)</div></div>
      <div class="stat-card"><div class="stat-number"><%= slaCounts.ok %></div><div class="stat-label">On track</div></div>
    </div>
    <% if (atRisk.length) { %>
      <table class="ticket-table">
        <thead><tr><th>ID</th><th>Title</th><th>Priority</th><th>Assignee</th><th>Clock</th><th>SLA</th></tr></thead>
        <tbody>
          <% atRisk.forEach(function(t) {
               var c = t.sla.firstResponse.running ? t.sla.firstResponse : t.sla.resolution;
               var label = (t.sla.firstResponse.running ? 'First response ' : 'Resolution ') + c.elapsedHours + 'h / ' + c.targetHours + 'h'; %>
            <tr onclick="location.href='/tickets/<%= t.ticketId %>'">
              <td><a href="/tickets/<%= t.ticketId %>"><%= t.ticketId %></a></td>
              <td><%= t.title %></td>
              <td><span class="pill pill-priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span></td>
              <td><%= t.assigneeName || '—' %></td>
              <td class="small"><%= label %></td>
              <td><%- include('partials/sla-pill', { sla: t.sla }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="muted">Nothing at risk right now.</p>
    <% } %>

    <div class="three-col mt">
      <div>
        <h2>By category</h2>
        <ul class="bar-list">
          <% Object.keys(byCategory).forEach(function(c) { %>
            <li><span><%= c %></span><span class="count"><%= byCategory[c] %></span></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h2>By priority</h2>
        <ul class="bar-list">
          <% Object.keys(byPriority).forEach(function(p) { %>
            <li><span><%= p %></span><span class="count"><%= byPriority[p] %></span></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h2>Agent workload</h2>
        <% if (workloads.length === 0) { %>
          <p class="muted">No agents yet.</p>
        <% } else { %>
          <ul class="bar-list">
            <% workloads.forEach(function(a) { %>
              <li><span><%= a.name %></span><span class="count"><%= a.active %> active</span></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>

    <h2 class="mt">AI features</h2>
    <ul class="bar-list">
      <li><span>Tickets checked for duplicates</span><span class="count"><%= dupStats.checked %></span></li>
      <li><span>&hellip; flagged by AI method</span><span class="count"><%= dupStats.aiFlagged %></span></li>
      <li><span>&hellip; flagged by keyword baseline</span><span class="count"><%= dupStats.baselineFlagged %></span></li>
      <li><span>&hellip; AI method skipped/failed</span><span class="count"><%= dupStats.aiSkipped %></span></li>
      <li><span>Category suggestions kept as-is</span><span class="count"><%= suggestionStats.accepted %> / <%= suggestionStats.total %></span></li>
    </ul>

    <h2 class="mt">All tickets</h2>
    <table class="ticket-table">
      <thead>
        <tr><th>ID</th><th>Title</th><th>Requester</th><th>Assignee</th><th>Priority</th><th>Status</th><th>SLA</th></tr>
      </thead>
      <tbody>
        <% tickets.forEach(function(t) { %>
          <tr onclick="location.href='/tickets/<%= t.ticketId %>'">
            <td><a href="/tickets/<%= t.ticketId %>"><%= t.ticketId %></a></td>
            <td><%= t.title %> <%- include('partials/dup-badge', { t }) %></td>
            <td><%= t.requesterName %></td>
            <td><%= t.assigneeName || '—' %></td>
            <td><span class="pill pill-priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span></td>
            <td><span class="pill pill-status-<%= t.status.replace(' ', '-').toLowerCase() %>"><%= t.status %></span></td>
            <td><%- include('partials/sla-pill', { sla: t.sla }) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>
