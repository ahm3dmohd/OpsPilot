<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'My tickets' }) %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <div class="page-header">
      <h1>My tickets</h1>
      <a href="/tickets/new" class="button">+ New ticket</a>
    </div>

    <% if (tickets.length === 0) { %>
      <p class="muted">You haven't submitted any tickets yet.</p>
    <% } else { %>
      <table class="ticket-table">
        <thead>
          <tr><th>ID</th><th>Title</th><th>Category</th><th>Priority</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% tickets.forEach(function(t) { %>
            <tr onclick="location.href='/tickets/<%= t.ticketId %>'">
              <td><%= t.ticketId %></td>
              <td><%= t.title %></td>
              <td><%= t.category %></td>
              <td><span class="pill pill-priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span></td>
              <td><span class="pill pill-status-<%= t.status.replace(' ', '-').toLowerCase() %>"><%= t.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
