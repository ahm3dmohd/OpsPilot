<%- include('partials/layout-top', { title: 'Knowledge base' }) %>
<% var staff = can('kb.edit'); %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1>Knowledge base</h1>
    <p class="mt-1 text-sm text-muted">Fixes for common problems<%= staff ? ', with how often each one is read and found helpful' : '' %>.</p>
  </div>
  <% if (staff) { %><a href="/kb/new" class="btn-primary"><%- icon('plus') %> New article</a><% } %>
</div>
<% if (flash === 'deleted') { %><p class="notice-ok mt-4">Article deleted.</p><% } %>

<form action="/kb" method="GET" class="mt-6 flex max-w-xl gap-2">
  <input class="input" type="text" name="q" value="<%= q %>" maxlength="200" placeholder="Search articles" />
  <button type="submit" class="btn-secondary"><%- icon('search') %> Search</button>
  <% if (q) { %><a href="/kb" class="btn-ghost">Clear</a><% } %>
</form>

<% if (articles.length === 0) { %>
  <p class="mt-6 text-sm text-muted"><%= q ? 'No articles match that search. Try fewer or different words.' : 'No articles yet.' %></p>
<% } else { %>
  <section class="panel mt-4 overflow-hidden">
    <table class="data-table">
      <thead>
        <tr><th class="w-24">Article</th><th>Title</th><th>Category</th>
          <% if (staff) { %><th class="text-right">Views</th><th class="text-right">Helpful</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% articles.forEach(function(a) { var votes = a.helpful + a.notHelpful; %>
          <tr class="cursor-pointer hover:bg-sunken" data-href="/kb/<%= a.articleId %>">
            <td><a href="/kb/<%= a.articleId %>" class="callsign text-brand"><%= a.articleId %></a></td>
            <td class="font-medium"><%= a.title %></td>
            <td class="text-ink-soft"><%= a.category %></td>
            <% if (staff) { %>
              <td class="text-right tabular-nums"><%= a.views %></td>
              <td class="text-right tabular-nums"><%= votes ? Math.round(a.helpful / votes * 100) + '% of ' + votes : '–' %></td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<% if (!staff) { %><%- include('partials/help-widget') %><% } %>
<%- include('partials/layout-bottom') %>
