<%- include('partials/layout-top', { title: 'New ticket' }) %>

<div class="max-w-2xl">
  <h1>Report a problem</h1>
  <p class="mt-1 text-ink-soft">Describe what's wrong. IT will see it straight away.</p>

  <% if (error) { %><p class="notice-error mt-6" role="alert"><%= error %></p><% } %>

  <% if (help && (help.articles.length || help.ownTickets.length)) { %>
    <section class="panel mt-6 border-info/40 overflow-hidden" aria-labelledby="mightHelp">
      <h2 id="mightHelp" class="flex items-center gap-2 border-b border-line bg-info-soft px-5 py-3 text-base text-info"><%- icon('life-buoy', 'size-[18px]') %> This might fix it without a ticket</h2>
      <div class="divide-y divide-line">
        <% help.ownTickets.forEach(function(t) { %>
          <p class="px-5 py-3 text-sm">You already have an open ticket that looks related:
            <a href="/tickets/<%= t.ticketId %>"><span class="callsign text-brand"><%= t.ticketId %></span> <%= t.title %></a> (<%= t.status %>). You can add a comment there instead.</p>
        <% }) %>
        <% help.articles.forEach(function(a) { %>
          <div class="px-5 py-3">
            <a href="/kb/<%= a.articleId %>" target="_blank" class="font-medium"><%= a.title %></a>
            <p class="mt-1 text-sm text-ink-soft"><%= a.body %></p>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <form action="/tickets" method="POST" class="panel panel-body mt-6 space-y-5">
    <label class="field">Title
      <input class="input" type="text" name="title" required maxlength="150" autofocus placeholder="For example: VPN disconnects every few minutes" value="<%= form.title || '' %>" />
    </label>
    <label class="field">What's happening?
      <textarea class="input" name="description" rows="5" required maxlength="5000" placeholder="When did it start? What have you already tried?"><%= form.description || '' %></textarea>
    </label>

    <div class="rounded-md border border-dashed border-line bg-sunken p-4">
      <button type="submit" formaction="/tickets/new/suggest" formnovalidate class="btn-secondary btn-sm"><%- icon('sparkles', 'size-3.5') %> Suggest a category and check for quick fixes</button>
      <% if (suggestion) { %>
        <p class="mt-2 text-sm text-ink-soft">
          Suggested: <strong><%= suggestion.category %></strong>
          (<%= suggestion.method === 'ai' ? 'AI' : 'keyword match' %>; <%= Math.round(suggestion.confidence * 100) %>% weighted vote among the <%= suggestion.neighbours.length %> most similar tickets). Change it below if it's wrong.
        </p>
        <input type="hidden" name="suggestedCategory" value="<%= suggestion.category %>" />
        <input type="hidden" name="suggestionMethod" value="<%= suggestion.method %>" />
      <% } else { %>
        <p class="hint mt-2">Optional. Uses your title and description.</p>
      <% } %>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <label class="field">Category
        <select class="input" name="category">
          <% CATEGORIES.forEach(function(c) { %><option <%= (form.category || 'General') === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </label>
      <label class="field">Priority
        <select class="input" name="priority">
          <% PRIORITIES.forEach(function(p) { %><option <%= (form.priority || 'Medium') === p ? 'selected' : '' %>><%= p %></option><% }) %>
        </select>
        <span class="hint">Urgent means you or your team can't work at all.</span>
      </label>
    </div>
    <div class="flex justify-end border-t border-line pt-5">
      <button type="submit" class="btn-primary"><%- icon('send') %> Submit ticket</button>
    </div>
  </form>
</div>

<%- include('partials/help-widget') %>
<%- include('partials/layout-bottom') %>
