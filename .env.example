# Copy this file to .env and fill in real values. Never commit .env itself.
# Leave MONGODB_URI blank to run in mock-data mode (in-memory users and
# tickets, no database needed) - good for checking the app quickly. Demo
# login credentials for mock mode are in README.md.

PORT=3000

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
# Plain MongoDB is enough - duplicate-ticket detection compares embeddings
# in application code (cosine similarity over all tickets), not with Atlas
# Vector Search, so no special Atlas feature needs enabling.
MONGODB_URI=

# OpenAI API key - used for embeddings (text-embedding-3-small) by the
# duplicate-ticket detection feature. Without this set, that feature
# silently falls back to baseline-only (keyword) matching; nothing breaks.
LLM_API_KEY=

# Session cookie secret - any long random string
SESSION_SECRET=
