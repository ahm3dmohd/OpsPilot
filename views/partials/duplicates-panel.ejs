<%# Possible duplicates, staff only. Expects: ticket, liveThresholds ({ ai, baseline }).
    Both methods' results side by side, each score shown as a labelled
    percentage and bar against its own threshold, with a plain-language
    reason, and which suggestions only one method found. %>
<% var d = ticket.duplicates;
   var pct = function(x) { return Math.round(x * 100) + '%'; };
   var aiOk = d && d.ai.status === 'ok';
   var aiIds = aiOk ? d.ai.matches.map(function(m) { return m.ticketId; }) : [];
   var kwIds = d ? d.baseline.matches.map(function(m) { return m.ticketId; }) : [];
   var both = aiIds.filter(function(id) { return kwIds.indexOf(id) !== -1; });
   var aiOnly = aiIds.filter(function(id) { return kwIds.indexOf(id) === -1; });
   var kwOnly = kwIds.filter(function(id) { return aiIds.indexOf(id) === -1; });
   var methods = d ? [
     { key: 'ai', title: 'AI (embeddings + cosine)', measure: 'Meaning similarity', explain: 'Compares what the tickets mean, so it can match different wording.', r: d.ai, live: liveThresholds.ai, others: kwIds, otherName: 'baseline' },
     { key: 'baseline', title: 'Baseline (keywords + Jaccard)', measure: 'Keyword overlap', explain: 'Share of important words both tickets use. Only matches the same wording.', r: d.baseline, live: liveThresholds.baseline, others: aiIds, otherName: 'AI' }
   ] : []; %>
<section id="duplicates" class="panel overflow-hidden" aria-labelledby="dupHeading">
  <div class="panel-head">
    <div>
      <h2 id="dupHeading">Possible duplicates</h2>
      <% if (d) { %>
        <p class="text-xs text-muted">Two independent methods compared this ticket with <%= d.comparedAgainst %> others <span title="<%= fullDate(d.baseline.ranAt) %>"><%= timeAgo(d.baseline.ranAt) %></span>. Their scores are on different scales, so each is compared with its own threshold.</p>
      <% } %>
    </div>
    <form action="/tickets/<%= ticket.ticketId %>/duplicates" method="POST">
      <button type="submit" class="btn-secondary btn-sm"><%- icon('refresh-cw', 'size-3.5') %> Re-run check</button>
    </form>
  </div>

  <% if (!d) { %>
    <p class="panel-body text-sm text-muted">Not checked yet. Choose Re-run check to compare it with other tickets.</p>
  <% } else { %>
    <%# ---- How the two methods compare on this ticket ---- %>
    <div class="border-b border-line bg-sunken px-5 py-3 text-sm" data-dup-compare>
      <% if (!aiOk) { %>
        <p class="text-ink-soft">The AI method didn't run on this ticket, so only the keyword baseline's suggestions are shown.</p>
      <% } else if (!aiIds.length && !kwIds.length) { %>
        <p class="text-ink-soft">Neither method found a ticket above its threshold.</p>
      <% } else { %>
        <p class="font-medium text-ink">
          <% if (aiOnly.length) { %>The AI found <%= aiOnly.length %> the keyword baseline missed.<% } else if (kwOnly.length) { %>The keyword baseline found <%= kwOnly.length %> the AI didn't.<% } else { %>Both methods agree.<% } %>
        </p>
        <ul class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1 text-ink-soft">
          <li><span class="agree-tag-both">Both</span> <%= both.length ? both.join(', ') : 'none' %></li>
          <li><span class="agree-tag-ai">AI only</span> <%= aiOnly.length ? aiOnly.join(', ') : 'none' %></li>
          <li><span class="agree-tag-baseline">Baseline only</span> <%= kwOnly.length ? kwOnly.join(', ') : 'none' %></li>
        </ul>
      <% } %>
    </div>

    <div class="grid divide-y divide-line md:grid-cols-2 md:divide-x md:divide-y-0">
      <% methods.forEach(function(meth) { var r = meth.r; %>
        <div class="p-5" data-method="<%= meth.key %>">
          <h3><%= meth.title %></h3>
          <p class="mt-0.5 text-xs text-muted"><%= meth.measure %>: <%= meth.explain %><% if (r.model) { %> Model <%= r.model %>.<% } %></p>
          <p class="mt-1 text-xs text-ink-soft">Threshold <strong class="tabular-nums" data-threshold="<%= r.threshold %>"><%= pct(r.threshold) %></strong><% if (meth.live !== r.threshold) { %> <span class="text-caution">(checked at this value; the current setting is <%= pct(meth.live) %>, re-run to apply it)</span><% } %></p>
          <% if (r.status !== 'ok') { %>
            <p class="mt-3 text-sm text-muted"><%= r.status === 'error' ? 'Failed (AI service error)' : 'Skipped' %>: <%= r.reason %></p>
          <% } else if (r.matches.length === 0) { %>
            <p class="mt-3 text-sm text-muted">No ticket reached the threshold (<%= pct(r.threshold) %>).</p>
          <% } else { %>
            <ul class="mt-3 space-y-4">
              <% r.matches.forEach(function(m, idx) {
                   var foundByOther = meth.others.indexOf(m.ticketId) !== -1;
                   var aboveOrAt = m.score > r.threshold ? 'is above' : 'reaches'; %>
                <li class="text-sm" data-dup-match="<%= m.ticketId %>">
                  <p>
                    <a href="/tickets/<%= m.ticketId %>" class="callsign text-brand-ink"><%= m.ticketId %></a>
                    <span class="text-ink"><%= m.title %></span>
                    <span class="text-xs text-muted">· <%= m.status %></span>
                  </p>
                  <% if (aiOk) { %>
                    <p class="mt-1"><span class="<%= foundByOther ? 'agree-tag-both' : 'agree-tag-' + meth.key %>"><%= foundByOther ? 'Also found by ' + meth.otherName : (meth.key === 'ai' ? 'AI only: the baseline missed it' : 'Baseline only: the AI missed it') %></span></p>
                  <% } %>
                  <div class="mt-2 flex items-center gap-3">
                    <span class="w-36 shrink-0 text-xs text-ink-soft"><%= meth.measure %></span>
                    <span class="score-bar" role="img" aria-label="<%= meth.measure %> <%= pct(m.score) %>, threshold <%= pct(r.threshold) %>">
                      <span class="score-fill" style="width: <%= Math.min(100, Math.round(m.score * 100)) %>%; --i: <%= idx %>"></span>
                      <span class="score-threshold" style="left: <%= Math.round(r.threshold * 100) %>%; --i: <%= idx %>" title="Threshold <%= pct(r.threshold) %>"></span>
                    </span>
                    <span class="w-10 shrink-0 text-right font-semibold tabular-nums text-brand-ink" data-score="<%= m.score %>"><%= pct(m.score) %></span>
                  </div>
                  <p class="mt-1 text-xs text-muted" data-why>Suggested because <%= meth.measure.toLowerCase() %> (<%= pct(m.score) %>) <%= aboveOrAt %> the threshold (<%= pct(r.threshold) %>).</p>
                  <% if (!ticket.mergedInto) { %>
                    <span class="mt-2 flex flex-wrap gap-2">
                      <form action="/tickets/<%= ticket.ticketId %>/duplicates/<%= m.ticketId %>/confirm" method="POST" data-confirm="Merge these two tickets? The newer one is closed and its description and comments are copied to the older one as an internal note.">
                        <button type="submit" class="btn-secondary btn-sm" title="Confirm duplicate: the newer ticket is merged into the older one"><%- icon('git-merge', 'size-3.5') %> Confirm &amp; merge</button>
                      </form>
                      <form action="/tickets/<%= ticket.ticketId %>/duplicates/<%= m.ticketId %>/reject" method="POST">
                        <button type="submit" class="btn-ghost btn-sm" title="Not a duplicate: don't suggest this pair again"><%- icon('x', 'size-3.5') %> Reject</button>
                      </form>
                    </span>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
