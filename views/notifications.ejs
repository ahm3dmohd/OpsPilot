<%- include('partials/layout-top', { title: 'Notifications' }) %>

<div class="flex max-w-3xl flex-wrap items-end justify-between gap-4">
  <div>
    <h1>Notifications</h1>
    <p class="mt-1 text-sm text-muted">Updates on tickets you reported or work on.</p>
  </div>
  <% if (notifications.some(function(n) { return !n.read; })) { %>
    <form action="/notifications/read-all" method="POST">
      <button type="submit" class="btn-secondary"><%- icon('check') %> Mark all read</button>
    </form>
  <% } %>
</div>

<% if (notifications.length === 0) { %>
  <p class="mt-6 max-w-3xl text-sm text-muted">Nothing yet. You'll be told here when someone picks up, updates or comments on a ticket you're involved in.</p>
<% } else { %>
  <ul class="panel mt-6 max-w-3xl divide-y divide-line overflow-hidden">
    <% notifications.forEach(function(n) { %>
      <li>
        <form action="/notifications/<%= n.id %>/open" method="POST">
          <button type="submit" class="flex w-full cursor-pointer items-start gap-3 px-5 py-3.5 text-left hover:bg-sunken <%= n.read ? 'text-ink-soft' : 'text-ink' %>">
            <span class="mt-2 size-2 shrink-0 rounded-full <%= n.read ? 'bg-transparent' : 'bg-brand' %>" aria-label="<%= n.read ? '' : 'unread' %>"></span>
            <span class="min-w-0 flex-1 text-[15px] <%= n.read ? '' : 'font-medium' %>"><%= n.message %></span>
            <span class="shrink-0 text-xs text-muted" title="<%= fullDate(n.createdAt) %>"><%= timeAgo(n.createdAt) %></span>
          </button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/layout-bottom') %>
