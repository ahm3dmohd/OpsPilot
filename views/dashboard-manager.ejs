<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Manager overview' }) %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <div class="page-header">
      <h1>Overview</h1>
      <div class="header-actions">
        <span class="muted small">Data: <%= mode === 'db' ? 'MongoDB' : 'mock (in-memory)' %></span>
        <a href="/reports/tickets.csv" class="button">Export CSV</a>
      </div>
    </div>

    <p class="muted small">Every number is a link to the tickets behind it.</p>
    <div class="stat-grid">
      <a class="stat-card" href="<%= total.href %>">
        <div class="stat-number"><%= total.count %></div>
        <div class="stat-label">Total tickets</div>
      </a>
      <% byStatus.forEach(function(x) { %>
        <a class="stat-card" href="<%= x.href %>">
          <div class="stat-number"><%= x.count %></div>
          <div class="stat-label"><%= x.label %></div>
        </a>
      <% }) %>
      <a class="stat-card" href="<%= unassigned.href %>">
        <div class="stat-number"><%= unassigned.count %></div>
        <div class="stat-label">Active, unassigned</div>
      </a>
    </div>

    <h2>SLA watch</h2>
    <p class="muted small">Active tickets only (Open or In Progress).</p>
    <div class="stat-grid">
      <% var slaText = { breached: 'Breached', at_risk: 'At risk (&ge;75% of target used)', ok: 'On track' }; %>
      <% slaCards.forEach(function(c) { %>
        <a class="stat-card sla-card-<%= c.key %>" href="<%= c.href %>">
          <div class="stat-number"><%= c.count %></div>
          <div class="stat-label"><%- slaText[c.key] %></div>
        </a>
      <% }) %>
    </div>
    <% if (atRisk.length) { %>
      <table class="ticket-table">
        <thead><tr><th>ID</th><th>Title</th><th>Priority</th><th>Assignee</th><th>Clock</th><th>SLA</th></tr></thead>
        <tbody>
          <% atRisk.forEach(function(t) {
               var c = t.sla.firstResponse.running ? t.sla.firstResponse : t.sla.resolution;
               var label = (t.sla.firstResponse.running ? 'First response ' : 'Resolution ') + c.elapsedHours + 'h / ' + c.targetHours + 'h'; %>
            <tr onclick="location.href='/tickets/<%= t.ticketId %>'">
              <td><a href="/tickets/<%= t.ticketId %>"><%= t.ticketId %></a></td>
              <td><%= t.title %></td>
              <td><span class="pill pill-priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span></td>
              <td><%= t.assigneeName || '—' %></td>
              <td class="small"><%= label %></td>
              <td><%- include('partials/sla-pill', { sla: t.sla }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="muted">Nothing at risk right now.</p>
    <% } %>

    <div class="three-col mt">
      <div>
        <h2>By category</h2>
        <ul class="bar-list">
          <% byCategory.forEach(function(x) { %>
            <li><a href="<%= x.href %>"><span><%= x.label %></span><span class="count"><%= x.count %></span></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h2>By priority</h2>
        <ul class="bar-list">
          <% byPriority.forEach(function(x) { %>
            <li><a href="<%= x.href %>"><span><%= x.label %></span><span class="count"><%= x.count %></span></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h2>Agent workload</h2>
        <% if (workloads.length === 0) { %>
          <p class="muted">No agents yet.</p>
        <% } else { %>
          <ul class="bar-list">
            <% workloads.forEach(function(x) { %>
              <li><a href="<%= x.href %>"><span><%= x.label %></span><span class="count"><%= x.count %> in progress</span></a></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>

    <h2 class="mt">AI features</h2>
    <ul class="bar-list">
      <% dupStats.forEach(function(x) { %>
        <li><a href="<%= x.href %>"><span><%= x.label %></span><span class="count"><%= x.count %></span></a></li>
      <% }) %>
      <li>
        <span>Category suggestions kept as-is</span>
        <span class="count"><a href="<%= suggestionStats.accepted.href %>"><%= suggestionStats.accepted.count %></a> / <a href="<%= suggestionStats.total.href %>"><%= suggestionStats.total.count %></a></span>
      </li>
    </ul>
    <p class="small"><a href="/evaluation">See the measured AI-vs-baseline evaluation &rarr;</a></p>

    <h2 class="mt">Knowledge base</h2>
    <% if (kbStats.length === 0) { %>
      <p class="muted">No articles yet.</p>
    <% } else { %>
      <table class="ticket-table">
        <thead><tr><th>Article</th><th>Views</th><th>Helpful</th><th>Not helpful</th></tr></thead>
        <tbody>
          <% kbStats.forEach(function(a) { %>
            <tr onclick="location.href='/kb/<%= a.articleId %>'">
              <td><a href="/kb/<%= a.articleId %>"><%= a.articleId %></a> <%= a.title %></td>
              <td><a href="/kb/<%= a.articleId %>"><%= a.views %></a></td><td><a href="/kb/<%= a.articleId %>"><%= a.helpful %></a></td><td><a href="/kb/<%= a.articleId %>"><%= a.notHelpful %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="small"><a href="/kb">Manage articles &rarr;</a></p>
    <% } %>

    <div class="page-header mt">
      <h2>All tickets</h2>
      <a href="/tickets" class="small">Filter &amp; search &rarr;</a>
    </div>
    <table class="ticket-table">
      <thead>
        <tr><th>ID</th><th>Title</th><th>Requester</th><th>Assignee</th><th>Priority</th><th>Status</th><th>SLA</th></tr>
      </thead>
      <tbody>
        <% tickets.forEach(function(t) { %>
          <tr onclick="location.href='/tickets/<%= t.ticketId %>'">
            <td><a href="/tickets/<%= t.ticketId %>"><%= t.ticketId %></a></td>
            <td><%= t.title %> <%- include('partials/dup-badge', { t }) %></td>
            <td><%= t.requesterName %></td>
            <td><%= t.assigneeName || '—' %></td>
            <td><span class="pill pill-priority-<%= t.priority.toLowerCase() %>"><%= t.priority %></span></td>
            <td><span class="pill pill-status-<%= t.status.replace(' ', '-').toLowerCase() %>"><%= t.status %></span></td>
            <td><%- include('partials/sla-pill', { sla: t.sla }) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>
