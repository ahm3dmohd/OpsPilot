<%- include('partials/layout-top', { title: 'Edit canned response' }) %>

<a href="/canned" class="inline-flex items-center gap-1.5 text-sm text-ink-soft no-underline hover:text-ink"><%- icon('arrow-left') %> Canned responses</a>

<div class="mt-4 max-w-2xl">
  <h1>Edit canned response</h1>
  <% if (error) { %><p class="notice-error mt-6" role="alert"><%= error %></p><% } %>
  <form action="/canned/<%= response.id %>" method="POST" class="panel panel-body mt-6 space-y-5">
    <label class="field">Title
      <input class="input" type="text" name="title" required maxlength="100" value="<%= form.title || '' %>" />
    </label>
    <label class="field">Text
      <textarea class="input" name="body" rows="8" required maxlength="5000"><%= form.body || '' %></textarea>
    </label>
    <div class="flex justify-end border-t border-line pt-5">
      <button type="submit" class="btn-primary">Save changes</button>
    </div>
  </form>
</div>

<%- include('partials/layout-bottom') %>
