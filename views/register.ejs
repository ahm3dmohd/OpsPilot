<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Register' }) %>
</head>
<body>
  <main class="auth-container">
    <h1>OpsPilot</h1>
    <p class="subtitle">Create an account.</p>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form action="/register" method="POST" class="auth-form">
      <label>Name
        <input type="text" name="name" required autofocus />
      </label>
      <label>Email
        <input type="email" name="email" required />
      </label>
      <label>Password
        <input type="password" name="password" required minlength="6" />
      </label>
      <label>Role
        <select name="role" required>
          <% roles.forEach(function(r) { %>
            <option value="<%= r %>"><%= r.replace('_', ' ') %></option>
          <% }) %>
        </select>
      </label>
      <p class="muted small">Role is self-selected here for demo purposes only &mdash; a real deployment would assign roles by admin, not at signup.</p>
      <button type="submit">Create account</button>
    </form>

    <p class="muted">Already have an account? <a href="/login">Log in</a></p>
  </main>
</body>
</html>
