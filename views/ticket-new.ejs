<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'New ticket' }) %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container narrow">
    <h1>New ticket</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <% if (help && (help.articles.length || help.ownTickets.length)) { %>
      <div class="panel help-suggestions">
        <h3>Before you submit - does this help?</h3>
        <% help.ownTickets.forEach(function(t) { %>
          <p class="small">You already have an open ticket that looks related:
            <a href="/tickets/<%= t.ticketId %>"><%= t.ticketId %>: <%= t.title %></a> (<%= t.status %>). You can add a comment there instead.</p>
        <% }) %>
        <% help.articles.forEach(function(a) { %>
          <div class="help-article">
            <strong><%= a.title %></strong>
            <p class="small"><%= a.body %></p>
          </div>
        <% }) %>
      </div>
    <% } %>

    <form action="/tickets" method="POST" class="auth-form">
      <label>Title
        <input type="text" name="title" required maxlength="150" autofocus placeholder="Short summary of the issue" value="<%= form.title || '' %>" />
      </label>
      <label>Description
        <textarea name="description" rows="5" required maxlength="5000" placeholder="What's happening? What have you already tried?"><%= form.description || '' %></textarea>
      </label>

      <div class="suggest-row">
        <button type="submit" formaction="/tickets/new/suggest" formnovalidate class="secondary">Suggest category &amp; check help articles</button>
        <% if (suggestion) { %>
          <span class="small muted">
            Suggested: <strong><%= suggestion.category %></strong>
            (<%= suggestion.method === 'ai' ? 'AI' : 'keyword match' %>; <%= Math.round(suggestion.confidence * 100) %>% weighted vote among the <%= suggestion.neighbours.length %> most similar tickets) &mdash; change it below if it's wrong.
          </span>
          <input type="hidden" name="suggestedCategory" value="<%= suggestion.category %>" />
          <input type="hidden" name="suggestionMethod" value="<%= suggestion.method %>" />
        <% } %>
      </div>

      <label>Category
        <select name="category">
          <% CATEGORIES.forEach(function(c) { %>
            <option <%= (form.category || 'General') === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </label>
      <label>Priority
        <select name="priority">
          <% PRIORITIES.forEach(function(p) { %>
            <option <%= (form.priority || 'Medium') === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
      </label>
      <button type="submit">Submit ticket</button>
    </form>
  </main>
  <%- include('partials/help-widget') %>
</body>
</html>
