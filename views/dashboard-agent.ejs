<%- include('partials/layout-top', { title: 'Queue' }) %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1>Open queue</h1>
    <p class="mt-1 text-sm text-muted">Unclaimed tickets, most urgent SLA first.</p>
  </div>
  <a href="/tickets" class="btn-secondary"><%- icon('search') %> Search all tickets</a>
</div>

<section class="panel mt-6 overflow-hidden" aria-label="Open queue">
  <% if (queue.length === 0) { %>
    <p class="flex items-center gap-2 px-5 py-8 text-sm text-ok"><%- icon('circle-check') %> The queue is empty. New tickets will appear here.</p>
  <% } else { %>
    <% queue.forEach(function(t) { %><%- include('partials/ticket-strip', { t: t, showAssignee: false }) %><% }) %>
  <% } %>
</section>

<h2 class="mt-10">My tickets</h2>
<section class="panel mt-3 overflow-hidden" aria-label="My tickets">
  <% if (mine.length === 0) { %>
    <p class="px-5 py-8 text-sm text-muted">You haven't claimed any tickets. Open one from the queue above and choose Claim.</p>
  <% } else { %>
    <% mine.forEach(function(t) { %><%- include('partials/ticket-strip', { t: t, showAssignee: false }) %><% }) %>
  <% } %>
</section>

<%- include('partials/layout-bottom') %>
