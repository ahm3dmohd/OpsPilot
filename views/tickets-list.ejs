<%- include('partials/layout-top', { title: 'Tickets' }) %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 data-count="<%= tickets.length %>"><%= tickets.length %> ticket<%= tickets.length === 1 ? '' : 's' %></h1>
    <p class="mt-1 text-sm text-muted"><%= chips.length ? 'Matching your filters, out of ' + total + ' in total.' : 'All tickets.' %></p>
  </div>
  <% if (managerRights) { %>
    <a href="/reports/tickets.csv<%= query %>" class="btn-secondary"><%- icon('download') %> <%= chips.length ? 'Export these as CSV' : 'Export CSV' %></a>
  <% } %>
</div>

<% if (chips.length) { %>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <% chips.forEach(function(c) { %>
      <a href="<%= c.removeUrl %>" class="chip" title="Remove this filter"><%= c.label %> <%- icon('x', 'size-3.5') %></a>
    <% }) %>
    <a href="/tickets" class="ml-1 text-sm">Clear all</a>
  </div>
<% } %>

<%# GET form: the URL always describes what's shown, so views can be bookmarked or shared. %>
<details class="panel mt-4" <%= chips.length ? '' : 'open' %>>
  <summary class="flex cursor-pointer items-center gap-2 px-5 py-3 text-sm font-medium text-ink-soft select-none"><%- icon('search') %> Filter and sort</summary>
  <form action="/tickets" method="GET" class="grid gap-3 border-t border-line p-5 sm:grid-cols-2 lg:grid-cols-4">
    <label class="field sm:col-span-2">Search
      <input class="input" type="text" name="q" value="<%= filters.q || '' %>" placeholder="ID, title, description or requester" maxlength="100" />
    </label>
    <label class="field">Status
      <select class="input" name="status">
        <option value="">Any status</option>
        <% STATUSES.forEach(function(v) { %><option <%= filters.status === v ? 'selected' : '' %>><%= v %></option><% }) %>
      </select>
    </label>
    <label class="field">Open or closed
      <select class="input" name="state">
        <option value="">Both</option>
        <option value="active" <%= filters.state ? 'selected' : '' %>>Active only</option>
      </select>
    </label>
    <label class="field">Priority
      <select class="input" name="priority">
        <option value="">Any priority</option>
        <% PRIORITIES.forEach(function(v) { %><option <%= filters.priority === v ? 'selected' : '' %>><%= v %></option><% }) %>
      </select>
    </label>
    <label class="field">Type
      <select class="input" name="type">
        <option value="">Any type</option>
        <% Object.keys(TYPE_LABELS).forEach(function(k) { %><option value="<%= k %>" <%= filters.type === k ? 'selected' : '' %>><%= TYPE_LABELS[k] %></option><% }) %>
      </select>
    </label>
    <label class="field">Department
      <select class="input" name="department">
        <option value="">Any department</option>
        <% departments.forEach(function(d) { %><option value="<%= d.code %>" <%= filters.department === d.code ? 'selected' : '' %>><%= d.name %></option><% }) %>
      </select>
    </label>
    <label class="field">Category
      <select class="input" name="category">
        <option value="">Any category</option>
        <% CATEGORIES.forEach(function(v) { %><option <%= filters.category === v ? 'selected' : '' %>><%= v %></option><% }) %>
      </select>
    </label>
    <label class="field">Assignee
      <select class="input" name="assignee">
        <option value="">Anyone</option>
        <option value="unassigned" <%= filters.assignee === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
        <% agents.forEach(function(a) { %><option value="<%= a.email %>" <%= filters.assignee === a.email ? 'selected' : '' %>><%= a.name %></option><% }) %>
      </select>
    </label>
    <label class="field">SLA
      <select class="input" name="sla">
        <option value="">Any SLA state</option>
        <% Object.keys(SLA_LABELS).forEach(function(k) { %><option value="<%= k %>" <%= filters.sla === k ? 'selected' : '' %>><%= SLA_LABELS[k] %></option><% }) %>
      </select>
    </label>
    <label class="field">Duplicate check
      <select class="input" name="dup">
        <option value="">Any result</option>
        <% Object.keys(DUP_LABELS).forEach(function(k) { %><option value="<%= k %>" <%= filters.dup === k ? 'selected' : '' %>><%= DUP_LABELS[k] %></option><% }) %>
      </select>
    </label>
    <label class="field">Category suggestion
      <select class="input" name="suggestion">
        <option value="">Any</option>
        <% Object.keys(SUGGESTION_LABELS).forEach(function(k) { %><option value="<%= k %>" <%= filters.suggestion === k ? 'selected' : '' %>><%= SUGGESTION_LABELS[k] %></option><% }) %>
      </select>
    </label>
    <label class="field">Sort
      <select class="input" name="sort">
        <% [['newest', 'Newest first'], ['oldest', 'Oldest first'], ['sla', 'Worst SLA first'], ['priority', 'Highest priority first']].forEach(function(o) { %>
          <option value="<%= o[0] %>" <%= sort === o[0] ? 'selected' : '' %>><%= o[1] %></option>
        <% }) %>
      </select>
    </label>
    <div class="flex items-end gap-2 sm:col-span-2 lg:col-span-4">
      <button type="submit" class="btn-primary">Apply filters</button>
      <a href="/tickets" class="btn-ghost">Reset</a>
    </div>
  </form>
</details>

<section class="panel mt-4 overflow-hidden" aria-label="Tickets">
  <% if (tickets.length === 0) { %>
    <p class="px-5 py-8 text-sm text-muted">No tickets match these filters. Remove a filter above to widen the search.</p>
  <% } else { %>
    <% tickets.forEach(function(t) { %><%- include('partials/ticket-strip', { t: t }) %><% }) %>
  <% } %>
</section>

<%- include('partials/layout-bottom') %>
