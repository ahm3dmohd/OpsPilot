<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= typeof title !== 'undefined' && title ? title + ' - OpsPilot' : 'OpsPilot' %></title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2311706b'/%3E%3Cpath d='M7 19h18M11 13h10' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E" />
<link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/css/app.css" />
<script>
  // Apply the saved theme before first paint, so dark mode doesn't flash.
  (function () {
    try {
      var saved = localStorage.getItem('opspilot-theme');
      var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (dark) document.documentElement.classList.add('dark');
      var palette = localStorage.getItem('opspilot-palette');
      if (palette && palette !== 'approach') document.documentElement.setAttribute('data-palette', palette);
    } catch (e) {}
  })();
</script>
<script src="/js/app.js" defer></script>
